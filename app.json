{
  "expo": {
    "name": "Dragon Inventory",
    "slug": "inventory-app",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "inventory-app",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0c1c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inventory.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to photograph inventory items and scan barcodes.",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access to select inventory photos and shipping labels.",
        "NSLocalNetworkUsageDescription": "Used to sync inventory with other devices on your Wi-Fi without a cloud backend.",
        "NSBonjourServices": [
          "_inventory-sync._tcp"
        ]
      },
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0c1c"
      },
      "package": "com.inventory.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE"
      ],
      "versionCode": 4
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Dragon Inventory to access your photos for inventory items and shipping labels.",
          "cameraPermission": "Allow Dragon Inventory to use the camera for photos and barcodes."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Dragon Inventory to use the camera for barcodes and item photos.",
          "barcodeScannerEnabled": true
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "ffbf9bc9-6203-4ee1-a985-2347f21679d8"
      }
    }
  }
}
