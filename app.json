{
  "expo": {
    "name": "Inventory Manager",
    "slug": "inventory-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "inventory",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inventory.manager",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Inventory Manager to use the camera for barcodes and item photos.",
        "NSPhotoLibraryUsageDescription": "Allow Inventory Manager to access photos for item images and shipping labels."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f1a"
      },
      "package": "com.inventory.manager",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Inventory Manager to use the camera for barcodes and item photos.",
          "barcodeScannerEnabled": true
        }
      ],
      "expo-sqlite"
    ]
  }
}
